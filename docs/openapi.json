{
  "openapi": "3.1.0",
  "info": {
    "title": "OrbitOpt - Autonomous Ground Station Scheduling API",
    "description": "API for Autonomous Ground Station Scheduling for Multi-Satellite Downlink optimization, conflict resolution, and schedule validation.",
    "version": "1.0.0"
  },
  "paths": {
    "/health": {
      "get": {
        "tags": [
          "Health"
        ],
        "summary": "Root Health Check",
        "description": "Verify application and database health.",
        "operationId": "check_health_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/health": {
      "get": {
        "tags": [
          "Health"
        ],
        "summary": "Application Health Check",
        "description": "Returns service availability, timestamp, active environment and database connectivity status.",
        "operationId": "check_health_api_v1_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/datasets": {
      "post": {
        "tags": [
          "Datasets"
        ],
        "summary": "Create and validate a scheduling scenario dataset",
        "description": "Registers a new dataset scenario containing Ground Stations and Satellite Pass opportunities.",
        "operationId": "create_dataset_api_v1_datasets_post",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/DatasetCreate"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DatasetRead"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      },
      "get": {
        "tags": [
          "Datasets"
        ],
        "summary": "List all dataset scenarios",
        "description": "Returns compact summary metadata for all registered datasets.",
        "operationId": "list_datasets_api_v1_datasets_get",
        "parameters": [
          {
            "name": "skip",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 0,
              "default": 0,
              "title": "Skip"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 100,
              "minimum": 1,
              "default": 50,
              "title": "Limit"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/DatasetSummary"
                  },
                  "title": "Response List Datasets Api V1 Datasets Get"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/datasets/{dataset_id}": {
      "get": {
        "tags": [
          "Datasets"
        ],
        "summary": "Retrieve dataset by ID",
        "description": "Fetches full scenario dataset details including ground stations and contact passes.",
        "operationId": "get_dataset_api_v1_datasets__dataset_id__get",
        "parameters": [
          {
            "name": "dataset_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Dataset Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DatasetRead"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/schedules/baseline": {
      "post": {
        "tags": [
          "Schedules"
        ],
        "summary": "Execute Baseline FCFS Scheduling",
        "description": "Runs the baseline First-Come-First-Served scheduling algorithm against the given dataset.",
        "operationId": "run_baseline_schedule_api_v1_schedules_baseline_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/BaselineScheduleRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ScheduleRunResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/schedules/optimize": {
      "post": {
        "tags": [
          "Schedules"
        ],
        "summary": "Execute CP-SAT Multi-Satellite Optimization",
        "description": "Runs the CP-SAT constraint programming optimizer to maximize downlink throughput and priority satisfaction.",
        "operationId": "run_optimize_schedule_api_v1_schedules_optimize_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/OptimizeScheduleRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ScheduleRunResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/schedules/{run_id}": {
      "get": {
        "tags": [
          "Schedules"
        ],
        "summary": "Retrieve Schedule Run Details",
        "description": "Fetches full allocation timeline, unassigned passes, and summary metrics for a previous run.",
        "operationId": "get_schedule_run_api_v1_schedules__run_id__get",
        "parameters": [
          {
            "name": "run_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Run Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ScheduleRunResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/schedules/{run_id}/metrics": {
      "get": {
        "tags": [
          "Schedules"
        ],
        "summary": "Retrieve Schedule Run Metrics",
        "description": "Retrieves comparative KPIs, priority satisfaction, and ground station utilization metrics for a run.",
        "operationId": "get_schedule_metrics_api_v1_schedules__run_id__metrics_get",
        "parameters": [
          {
            "name": "run_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Run Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ScheduleMetrics"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AlgorithmType": {
        "type": "string",
        "enum": [
          "baseline_fcfs",
          "cp_sat_optimizer",
          "mock_integration"
        ],
        "title": "AlgorithmType",
        "description": "Supported scheduling algorithm types."
      },
      "BaselineScheduleRequest": {
        "properties": {
          "dataset_id": {
            "type": "string",
            "title": "Dataset Id",
            "description": "Dataset ID to execute baseline on"
          },
          "setup_time_seconds": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Setup Time Seconds",
            "description": "Required re-pointing/calibration buffer between passes at the same station (seconds)",
            "default": 120
          }
        },
        "type": "object",
        "required": [
          "dataset_id"
        ],
        "title": "BaselineScheduleRequest",
        "description": "Request payload for running FCFS baseline schedule."
      },
      "DatasetCreate": {
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 128,
            "minLength": 1,
            "title": "Name",
            "description": "Descriptive name of the scheduling dataset scenario",
            "examples": [
              "LEO Constellation 24h Scenario"
            ]
          },
          "description": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 512
              },
              {
                "type": "null"
              }
            ],
            "title": "Description",
            "description": "Optional detailed overview of scenario objectives and constraints",
            "examples": [
              "Global multi-satellite downlink scenario across 5 polar and equatorial stations."
            ]
          },
          "ground_stations": {
            "items": {
              "$ref": "#/components/schemas/GroundStationCreate"
            },
            "type": "array",
            "minItems": 1,
            "title": "Ground Stations",
            "description": "List of ground stations participating in the scenario"
          },
          "satellite_passes": {
            "items": {
              "$ref": "#/components/schemas/SatellitePassCreate"
            },
            "type": "array",
            "minItems": 1,
            "title": "Satellite Passes",
            "description": "List of satellite contact pass opportunities"
          }
        },
        "type": "object",
        "required": [
          "name",
          "ground_stations",
          "satellite_passes"
        ],
        "title": "DatasetCreate",
        "description": "Schema for creating and registering a scenario dataset."
      },
      "DatasetRead": {
        "properties": {
          "dataset_id": {
            "type": "string",
            "title": "Dataset Id",
            "description": "Unique dataset identifier"
          },
          "name": {
            "type": "string",
            "title": "Name",
            "description": "Scenario name"
          },
          "description": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Description",
            "description": "Scenario description"
          },
          "ground_station_count": {
            "type": "integer",
            "title": "Ground Station Count",
            "description": "Total ground stations in dataset"
          },
          "satellite_pass_count": {
            "type": "integer",
            "title": "Satellite Pass Count",
            "description": "Total satellite passes in dataset"
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "title": "Created At",
            "description": "Creation timestamp in UTC"
          },
          "ground_stations": {
            "items": {
              "$ref": "#/components/schemas/GroundStationRead"
            },
            "type": "array",
            "title": "Ground Stations"
          },
          "satellite_passes": {
            "items": {
              "$ref": "#/components/schemas/SatellitePassRead"
            },
            "type": "array",
            "title": "Satellite Passes"
          }
        },
        "type": "object",
        "required": [
          "dataset_id",
          "name",
          "ground_station_count",
          "satellite_pass_count",
          "created_at"
        ],
        "title": "DatasetRead",
        "description": "Schema for reading a dataset with full details."
      },
      "DatasetSummary": {
        "properties": {
          "dataset_id": {
            "type": "string",
            "title": "Dataset Id"
          },
          "name": {
            "type": "string",
            "title": "Name"
          },
          "description": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Description"
          },
          "ground_station_count": {
            "type": "integer",
            "title": "Ground Station Count"
          },
          "satellite_pass_count": {
            "type": "integer",
            "title": "Satellite Pass Count"
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "title": "Created At"
          }
        },
        "type": "object",
        "required": [
          "dataset_id",
          "name",
          "ground_station_count",
          "satellite_pass_count",
          "created_at"
        ],
        "title": "DatasetSummary",
        "description": "Compact summary of a dataset for list views."
      },
      "GroundStationCreate": {
        "properties": {
          "station_id": {
            "type": "string",
            "maxLength": 64,
            "minLength": 1,
            "title": "Station Id",
            "description": "Unique identifier for the ground station (e.g. 'GS-SVALBARD')",
            "examples": [
              "GS-SVALBARD"
            ]
          },
          "name": {
            "type": "string",
            "maxLength": 128,
            "minLength": 1,
            "title": "Name",
            "description": "Human-readable ground station location/name",
            "examples": [
              "Svalbard Ground Station"
            ]
          },
          "latitude_deg": {
            "type": "number",
            "maximum": 90.0,
            "minimum": -90.0,
            "title": "Latitude Deg",
            "description": "Latitude in degrees [-90.0, 90.0]",
            "examples": [
              78.2297
            ]
          },
          "longitude_deg": {
            "type": "number",
            "maximum": 180.0,
            "minimum": -180.0,
            "title": "Longitude Deg",
            "description": "Longitude in degrees [-180.0, 180.0]",
            "examples": [
              15.4077
            ]
          },
          "elevation_mask_deg": {
            "type": "number",
            "maximum": 90.0,
            "minimum": 0.0,
            "title": "Elevation Mask Deg",
            "description": "Minimum horizon elevation angle in degrees for contact visibility [0.0, 90.0]",
            "default": 5.0,
            "examples": [
              5.0
            ]
          },
          "max_concurrent_passes": {
            "type": "integer",
            "minimum": 1.0,
            "title": "Max Concurrent Passes",
            "description": "Maximum concurrent satellite passes supported by this ground station (e.g., number of antennas)",
            "default": 1,
            "examples": [
              1
            ]
          },
          "supported_bands": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Supported Bands",
            "description": "Radio frequency bands supported by the ground station antennas",
            "examples": [
              [
                "S-band",
                "X-band",
                "Ka-band"
              ]
            ]
          }
        },
        "type": "object",
        "required": [
          "station_id",
          "name",
          "latitude_deg",
          "longitude_deg"
        ],
        "title": "GroundStationCreate",
        "description": "Schema for ground station creation input."
      },
      "GroundStationRead": {
        "properties": {
          "station_id": {
            "type": "string",
            "maxLength": 64,
            "minLength": 1,
            "title": "Station Id",
            "description": "Unique identifier for the ground station (e.g. 'GS-SVALBARD')",
            "examples": [
              "GS-SVALBARD"
            ]
          },
          "name": {
            "type": "string",
            "maxLength": 128,
            "minLength": 1,
            "title": "Name",
            "description": "Human-readable ground station location/name",
            "examples": [
              "Svalbard Ground Station"
            ]
          },
          "latitude_deg": {
            "type": "number",
            "maximum": 90.0,
            "minimum": -90.0,
            "title": "Latitude Deg",
            "description": "Latitude in degrees [-90.0, 90.0]",
            "examples": [
              78.2297
            ]
          },
          "longitude_deg": {
            "type": "number",
            "maximum": 180.0,
            "minimum": -180.0,
            "title": "Longitude Deg",
            "description": "Longitude in degrees [-180.0, 180.0]",
            "examples": [
              15.4077
            ]
          },
          "elevation_mask_deg": {
            "type": "number",
            "maximum": 90.0,
            "minimum": 0.0,
            "title": "Elevation Mask Deg",
            "description": "Minimum horizon elevation angle in degrees for contact visibility [0.0, 90.0]",
            "default": 5.0,
            "examples": [
              5.0
            ]
          },
          "max_concurrent_passes": {
            "type": "integer",
            "minimum": 1.0,
            "title": "Max Concurrent Passes",
            "description": "Maximum concurrent satellite passes supported by this ground station (e.g., number of antennas)",
            "default": 1,
            "examples": [
              1
            ]
          },
          "supported_bands": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Supported Bands",
            "description": "Radio frequency bands supported by the ground station antennas",
            "examples": [
              [
                "S-band",
                "X-band",
                "Ka-band"
              ]
            ]
          }
        },
        "type": "object",
        "required": [
          "station_id",
          "name",
          "latitude_deg",
          "longitude_deg"
        ],
        "title": "GroundStationRead",
        "description": "Schema for ground station retrieval response."
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "HealthResponse": {
        "properties": {
          "status": {
            "type": "string",
            "title": "Status",
            "description": "Operational status, e.g. 'healthy'"
          },
          "version": {
            "type": "string",
            "title": "Version",
            "description": "Application semantic version"
          },
          "timestamp": {
            "type": "string",
            "format": "date-time",
            "title": "Timestamp",
            "description": "Current UTC timestamp"
          },
          "environment": {
            "type": "string",
            "title": "Environment",
            "description": "Active environment name (e.g. development, production)"
          },
          "database_connected": {
            "type": "boolean",
            "title": "Database Connected",
            "description": "True if database connectivity is verified"
          }
        },
        "type": "object",
        "required": [
          "status",
          "version",
          "environment",
          "database_connected"
        ],
        "title": "HealthResponse",
        "description": "Health check endpoint response payload."
      },
      "OptimizeScheduleRequest": {
        "properties": {
          "dataset_id": {
            "type": "string",
            "title": "Dataset Id",
            "description": "Dataset ID to optimize"
          },
          "time_limit_seconds": {
            "type": "number",
            "maximum": 300.0,
            "exclusiveMinimum": 0.0,
            "title": "Time Limit Seconds",
            "description": "Maximum solver execution time limit in seconds",
            "default": 30.0
          },
          "setup_time_seconds": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Setup Time Seconds",
            "description": "Antenna slew and re-configuration buffer time in seconds",
            "default": 120
          },
          "priority_weights": {
            "anyOf": [
              {
                "additionalProperties": {
                  "type": "number"
                },
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Priority Weights",
            "description": "Custom weights assigned to priority levels 1-5 (1=Highest priority)"
          },
          "maximize_data_volume": {
            "type": "boolean",
            "title": "Maximize Data Volume",
            "description": "Whether objective function prioritizes total downlinked data volume alongside pass count",
            "default": true
          }
        },
        "type": "object",
        "required": [
          "dataset_id"
        ],
        "title": "OptimizeScheduleRequest",
        "description": "Request payload for running CP-SAT optimization."
      },
      "SatellitePassCreate": {
        "properties": {
          "pass_id": {
            "type": "string",
            "maxLength": 64,
            "minLength": 1,
            "title": "Pass Id",
            "description": "Unique identifier for the pass opportunity (e.g. 'PASS-SAT01-001')",
            "examples": [
              "PASS-SAT01-001"
            ]
          },
          "satellite_id": {
            "type": "string",
            "maxLength": 64,
            "minLength": 1,
            "title": "Satellite Id",
            "description": "Satellite identifier (e.g. 'SAT-EARTHOBS-1')",
            "examples": [
              "SAT-EARTHOBS-1"
            ]
          },
          "ground_station_id": {
            "type": "string",
            "maxLength": 64,
            "minLength": 1,
            "title": "Ground Station Id",
            "description": "Target Ground Station ID for this contact window",
            "examples": [
              "GS-SVALBARD"
            ]
          },
          "start_time": {
            "type": "string",
            "format": "date-time",
            "title": "Start Time",
            "description": "Pass start timestamp in UTC (ISO 8601)",
            "examples": [
              "2026-10-10T08:00:00Z"
            ]
          },
          "end_time": {
            "type": "string",
            "format": "date-time",
            "title": "End Time",
            "description": "Pass end timestamp in UTC (ISO 8601)",
            "examples": [
              "2026-10-10T08:12:00Z"
            ]
          },
          "max_elevation_deg": {
            "type": "number",
            "maximum": 90.0,
            "minimum": 0.0,
            "title": "Max Elevation Deg",
            "description": "Maximum elevation angle during the pass in degrees [0.0, 90.0]",
            "examples": [
              48.5
            ]
          },
          "priority": {
            "type": "integer",
            "maximum": 5.0,
            "minimum": 1.0,
            "title": "Priority",
            "description": "Priority of the pass (1 = Highest Priority, 5 = Lowest Priority)",
            "default": 3,
            "examples": [
              1
            ]
          },
          "data_volume_gb": {
            "type": "number",
            "minimum": 0.0,
            "title": "Data Volume Gb",
            "description": "Pending/transferable data volume in Gigabytes (GB) available for downlink",
            "default": 0.0,
            "examples": [
              42.5
            ]
          },
          "pending_data_gb": {
            "anyOf": [
              {
                "type": "number",
                "minimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Pending Data Gb",
            "description": "Explicit pending data volume on satellite in GB (alias for data_volume_gb)",
            "examples": [
              42.5
            ]
          },
          "effective_data_rate_mbps": {
            "anyOf": [
              {
                "type": "number",
                "exclusiveMinimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Effective Data Rate Mbps",
