# OrbitOpt Backend Environment Configuration
ENVIRONMENT=development
DEBUG=false

# Database Configuration
# PostgreSQL Production / Local Docker URL:
# DATABASE_URL=postgresql+asyncpg://orbitopt_user:orbitopt_password@localhost:5432/orbitopt_db
# SYNC_DATABASE_URL=postgresql://orbitopt_user:orbitopt_password@localhost:5432/orbitopt_db

# Local Default (SQLite):
DATABASE_URL=sqlite+aiosqlite:///./orbitopt.db
SYNC_DATABASE_URL=sqlite:///./orbitopt.db

# API Settings
API_V1_STR=/api/v1
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173

# Algorithm defaults
DEFAULT_SETUP_TIME_SECONDS=120
DEFAULT_OPTIMIZER_TIME_LIMIT_SECONDS=30.0
